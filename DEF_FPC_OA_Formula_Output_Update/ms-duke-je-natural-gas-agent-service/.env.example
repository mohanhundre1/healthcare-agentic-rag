# Copy to .env for local or Docker execution.
ENVIRONMENT=local
ROLE=executor
CNGADJ_AGENT_PORT=8022
A2A_HOST=duke-cngadj
CNGADJ_AGENT_URL=http://duke-cngadj:8022
ERP_TEMPLATE_AGENT_URL=http://duke-shared-agents:8002
SERVICE_BASE_URL=
A2A_BIND_HOST=0.0.0.0
A2A_ADVERTISE_HOST=

LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
CNGADJ_VISION_MODEL=gpt-4.1
CNGADJ_VISION_FALLBACK_MODEL=gpt-4.1

INTERNAL_SERVICE_KEY=<shared-internal-service-key>
CALLBACK_SECRET=<callback-secret>
AUTH_PROVIDER=local
JWT_SECRET=<local-dev-jwt-secret>
SECRET_PROVIDER=env
STORAGE_PROVIDER=fm
STORAGE_BACKEND=local
CALLBACK_BASE_URL=http://duke-api:8090
CALLBACK_URL_ALLOWED_HOSTS=duke-api,localhost,127.0.0.1,host.docker.internal
CALLBACK_TIMEOUT=30
CALLBACK_MAX_RETRIES=3
CONFIG_REGISTRY_URL=http://duke-api:8090
CONFIG_REGISTRY_ENABLED=true
CONFIG_REGISTRY_TIMEOUT=30
CONFIG_CACHE_TTL=18000
MEMORY_PROVIDER=conversation_manager
CONVERSATION_MANAGER_URL=
URI_GUARD_ALLOWED_SCHEMES=https,http,azure,blob
URI_GUARD_ALLOWED_HOSTS=*.blob.core.windows.net
URI_GUARD_DENY_PRIVATE_IPS=true
UPLOAD_DIR=/app/uploads
APP_OUTPUT_DIR=/app/app_output
AZURE_BLOB_CACHE_DIR=
STORAGE_DOWNLOAD_CONCURRENCY=8
CNGADJ_OUTPUT_DIR=/tmp/cngadj_output
CNGADJ_VISION_DPI=200
CNGADJ_VISION_MAX_TOKENS=2048
CNGADJ_VISION_TILING=off
CNGADJ_VISION_TILE_COLS=2
CNGADJ_VISION_TILE_ROWS=2
CNGADJ_VISION_TILE_OVERLAP=0.10
CNGADJ_VISION_INCLUDE_FULL_PAGE=1
OTEL_SERVICE_NAME=duke-cngadj
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=true
OTEL_CONSOLE_SPANS=0
DUKE_GENAI_TELEMETRY=off
OTEL_SEMCONV_STABILITY_OPT_IN=
